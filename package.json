{
  "name": "fusesoc-editor-support",
  "displayName": "FuseSoC Editor Support",
  "description": "FuseSoC .core file support: syntax highlighting, linting, and validation",
  "version": "0.4.0",
  "publisher": "Manas-Tanneeru",
  "icon": "fusesoc_logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtanneer/tools.extensions.vscode.fusesoc"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fusesoc",
    "hdl",
    "verilog",
    "vhdl",
    "fpga",
    "capi"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fusesoc-core",
        "aliases": [
          "FuseSoC Core",
          "fusesoc"
        ],
        "extensions": [
          ".core"
        ],
        "filenames": [
          "fusesoc.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fusesoc-core",
        "scopeName": "source.fusesoc",
        "path": "./syntaxes/fusesoc-core.tmLanguage.json",
        "embeddedLanguages": {
          "source.yaml": "yaml"
        }
      },
      {
        "scopeName": "source.fusesoc.injection",
        "path": "./syntaxes/fusesoc-injection.tmLanguage.json",
        "injectTo": [
          "source.fusesoc"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "lint": "eslint src",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
